# Copy this file to backend/.env and replace every change-me value.
DATABASE_URL=sqlite:///./database.db
SECRET_KEY=change-me-generate-a-long-random-secret
MODEL_SIGNING_KEY=change-me-generate-a-different-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
LOGIN_MAX_ATTEMPTS=20
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
